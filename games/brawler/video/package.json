    "lortor:preview": "remotion render Lortor-Preview out/lortor-preview.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.543"
  }
}